{
  "name": "libercast",
  "version": "0.9.0-beta.4",
  "description": "LiberCast \u2014 a free, open-source IPTV player. Xtream Codes, M3U and XMLTV EPG.",
  "license": "MIT",
  "author": "Veysel Olgac",
  "homepage": "https://github.com/olgacveysel/libercast",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "node test/run.mjs",
    "pack:win": "npm run build && npm run eula && electron-builder --win --publish never",
    "pack:win:dir": "npm run build && npm run eula && electron-builder --win --dir --publish never",
    "verify:detached": "npm run build && node -e \"const{cpSync,mkdirSync,rmSync}=require('fs');const d='node_modules/.cache/verify-detached';rmSync(d,{recursive:true,force:true});mkdirSync(d+'/main',{recursive:true});cpSync('out/preload',d+'/preload',{recursive:true});cpSync('out/renderer',d+'/renderer',{recursive:true})\" && esbuild src/main/windows/detached.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/verify-detached/main/detached.cjs --alias:@main/window=./test/browser/window-stub.cjs --alias:@main=./src/main --alias:@shared=./src/shared --external:electron --log-level=error && electron test/browser/verify-detached.cjs",
    "verify:multiview": "esbuild src/renderer/src/features/multiview/layout.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/verify-multiview/layout.cjs --log-level=error && electron test/browser/verify-multiview.cjs",
    "verify:player": "esbuild src/main/media/streamServer.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/verify-player/streamServer.cjs --alias:@main=./src/main --alias:@shared=./src/shared --alias:electron=./test/electron-stub.cjs --external:better-sqlite3 --external:ffmpeg-static --external:ffprobe-static --log-level=error && esbuild src/renderer/src/features/player/subtitleStyle.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/verify-player/subtitleStyle.cjs --alias:@shared=./src/shared --log-level=error && electron test/browser/verify-player.cjs",
    "verify:stall": "esbuild src/renderer/src/features/player/stall.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/verify-stall/stall.cjs --log-level=error && electron test/browser/verify-stall.cjs",
    "verify:i18n": "npm run build && electron test/browser/verify-i18n.cjs",
    "verify:merged": "npm run build && electron test/browser/verify-merged.cjs",
    "verify:updates": "npm run build && electron test/browser/verify-updates.cjs",
    "verify:nextup": "npm run build && electron test/browser/verify-nextup.cjs",
    "eula": "node tools/make-eula.mjs win32",
    "eula:linux": "node tools/make-eula.mjs linux",
    "pack:linux": "npm run build && npm run eula:linux && electron-builder --linux --publish never",
    "verify:credentials": "npm run build && electron test/browser/verify-credentials.cjs",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "verify:failover": "npm run build && electron test/browser/verify-failover.cjs",
    "verify:all": "node tools/verify-all.mjs",
    "ci": "npm run typecheck && npm test && npm run verify:all",
    "verify:vodfilters": "npm run build && electron test/browser/verify-vodfilters.cjs",
    "verify:pip": "npm run build && electron test/browser/verify-pip.cjs",
    "verify:mini": "npm run build && electron test/browser/verify-mini.cjs",
    "verify:tvnav": "npm run build && electron --enable-spatial-navigation test/browser/verify-tvnav.cjs",
    "verify:folders": "npm run build && electron test/browser/verify-folders.cjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "better-sqlite3": "^13.0.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@tanstack/react-query": "^5.56.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^44.10.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^2.3.0",
    "esbuild": "^0.21.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.5",
    "zustand": "^4.5.5"
  },
  "productName": "LiberCast"
}
